		lineageTag: 868b0fe4-4cdc-4a17-a827-67a768195cb9

	measure 'Avg Trip Duration' = AVERAGE('Fact_yellow_tripdata_2025-09'[trip_duration_min])
		formatString: 0
		lineageTag: 52eca9d5-5852-477b-b0e2-a11f78f0ee6f

	measure 'Trip Count by Pickup Hour' = ```
			CALCULATE(
			    [Trip Count], 
			    ALLEXCEPT('Fact_yellow_tripdata_2025-09', 'Fact_yellow_tripdata_2025-09'[PickupHour])
			)
			```
		formatString: 0
		lineageTag: 1bc25fb0-4ef6-4057-b3ae-adcaf6cce076

	measure 'Trips by Pickup Zone' = ```
			
			CALCULATE ( [Trip Count], USERELATIONSHIP ( 'DimLocation'[LocationID], 'Fact_yellow_tripdata_2025-09'[PULocationID] ) )
			
			```
		formatString: 0
		lineageTag: fd274488-0c72-43e3-b2e9-9c2fc2664038

	measure 'Trips by Dropoff Zone' = ```
			
			CALCULATE ( [Trip Count], USERELATIONSHIP ( 'DimLocation'[LocationID], 'Fact_yellow_tripdata_2025-09'[DOLocationID] ) )
			
			```
		formatString: 0
		lineageTag: 7ce6654e-35ae-4818-aeb8-fc2aff81243f

