		lineageTag: f0555dff-9fd6-4d7c-85bd-d59e1c399dec

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Avg Trip Distance' = AVERAGE('Fact_yellow_tripdata_2025-09'[trip_distance])
