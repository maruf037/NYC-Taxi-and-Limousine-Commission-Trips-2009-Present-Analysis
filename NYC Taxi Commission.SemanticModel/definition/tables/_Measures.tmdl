table _Measures
	lineageTag: f9eca89a-ace7-4a3c-9355-449e294bbd20

	measure 'Trip Count' = COUNTROWS('Fact_yellow_tripdata_2025-09')
		formatString: 0
		lineageTag: 064fa493-44b8-445e-899c-f7b39797b926

	measure 'Total Revenue' = SUM('Fact_yellow_tripdata_2025-09'[total_amount])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: c83e965a-f527-478e-a4d3-058216ce3819

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Avg Fare per Trip' = DIVIDE([Total Revenue], [Trip Count])
